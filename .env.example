CONSUL=127.0.0.1:8500
MESSAGE_BROKER_URL=amqp://user:pass@127.0.0.1:5672?heartbeat=10
DATA_SOURCE=postgres://user:pass@127.0.0.1:5432/webitel?application_name=storage&sslmode=disable&connect_timeout=10

PUBLIC_HOST=https://example.org
GRPC_ADDR=127.0.0.1

PRESIGNED_CERT=/opt/storage/key.pem
MEDIA_DIRECTORY=/opt/storage/data
TEMP_DIRECTORY=/var/cache/webitel-storage

# ID=1
# DEV=false
TRANSLATION_DIRECTORY=/usr/share/webitel/storage/i18n

# PUBLIC_ADDRESS=:10023
# INTERNAL_ADDRESS=:10021
# gRPC port (0 = random)
# GRPC_PORT=0
# GRPC_NETWORK=tcp

# MESSAGE_BROKER_EXCHANGE=cases
# TRIGGER_ENABLED=1

# SQL_DRIVER_NAME=postgres
# SQL_DATA_SOURCE_REPLICAS=
# SQL_MAX_IDLE_CONNS=5
# SQL_MAX_OPEN_CONNS=5
# SQL_LIFETIME_MILLISECONDS=300000
# SQL_TRACE=false
# SQL_LOG=false
# QUERY_TIMEOUT=10

# PRESIGNED_TIMEOUT=900000
# CRYPTO_KEY=

# Templated by storage at runtime ($DOMAIN/$Y/$M/$D/$H)
# MEDIA_STORE_PATTERN=$DOMAIN
# MAX_UPLOAD_FILE_SIZE=20MB
FILE_STORE_TYPE=local
# File expire day (0 = never delete)
FILE_STORE_EXPIRE_DAY=0
FILE_STORE_PROPS="{\"directory\": \"/opt/storage/recordings\", \"path_pattern\": \"$DOMAIN/$Y/$M/$D/$H\"}"
# PROXY_UPLOAD=
# SAFE_UPLOAD_MAX_SLEEP=60sec

# Outbound proxy settings file (http_proxy/https_proxy/no_proxy), watched for changes
# PROXY_CONFIG_FILE=/etc/webitel/proxy.yml
# WATCHERS_ENABLED=1

# CLAM_ADDRESS=
# Clam mode: aggressive | quarantine | skip
# CLAM_MODE=quarantine

# THUMBNAIL_FORCE_ENABLE=0
# THUMBNAIL_DEFAULT_SCALE=

# WBT_TTS_ENDPOINT=

# LOGGER_ENABLED=1
# Minimum level of application log records: trace | debug | info | warn | error | fatal.
# Case-insensitive, optional offset (info+2). An invalid value stops startup.
# LOG_LVL=debug

# Log exporters, comma-separated. Default: stdout: (text codec).
#   stdout: | stderr:                     console output
#   file:/var/log/webitel/storage.log     rotated file; params: ;max-size=100 (MB) ;max-age=30 (days) ;backups=3 ;compress=gzip ;localtime=UTC
#   otlpgrpc | otlphttp                   OTLP collector, see OTEL_EXPORTER_OTLP_* in .env.otel.example
#   none                                  disable logs; must be the only value
# stdout:, stderr: and file: exporters take a per-exporter codec: text | json | otel.
#   stdout:;codec=json   or   stdout://?codec=json   or   file:/var/log/webitel/storage.log;codec=json
# OTEL_LOGS_EXPORTER=stdout:
# OTEL_LOGS_EXPORTER=stdout:;codec=text,file:/var/log/webitel/storage.log;codec=json;max-size=50;backups=5

# Fallback codec for stdout/stderr/file exporters without their own ;codec= param.
# Default: text. Not required.
# OTEL_LOGRECORD_CODEC=json

# Repeated log records quota, on by default: off | on | window=1m,first=100,every=100,keys=10000
# OTEL_LOGS_THROTTLE=on

# OTEL_SDK_DISABLED=true drops all log records, console output included.

# Path to Google Cloud service-account JSON (only for GCS file store)
# GOOGLE_APPLICATION_CREDENTIALS=/opt/webitel/application_default_credentials.json

# Health: probe server address (/livez, /readyz, /healthz), empty disables it
# HEALTH_ADDRESS=127.0.0.1:10213
# Health: seconds before sd_notify reports READY=1 anyway; drain budget on shutdown
# HEALTH_START_TIMEOUT=60
# HEALTH_STOP_TIMEOUT=12

# Metrics: Prometheus exporter serving /metrics
# OTEL_METRICS_EXPORTER=prometheus
# OTEL_EXPORTER_PROMETHEUS_HOST=127.0.0.1
# OTEL_EXPORTER_PROMETHEUS_PORT=10113
